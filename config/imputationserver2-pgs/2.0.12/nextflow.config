// Server-level overrides for imputationserver2-pgs.
// Loaded after the app's own conf/base.config, so these take precedence.
// Do NOT modify the app directory — put all tuning here so app updates don't clobber it.

process {

    // EAGLE: uses task.cpus for --numThreads.
    // Actual peak RSS ~450 MB; 4 CPUs allows full thread utilisation.
    // With executor.cpus=64 this allows 16 concurrent EAGLE tasks (64 CPUs fully used).
    withName: 'EAGLE' {
        cpus   = 4
        memory = { 2.GB * task.attempt }
        // After MINIMAC4 consumes the phased VCF, MINIMAC4's afterScript deletes it.
        // Nothing extra needed here.
    }

    // MINIMAC4: actual peak RSS ~1.2 GB, CPU% ~110% (effectively 1 core + bursts).
    // Right-size memory from 12 GB → 4 GB.
    // maxForks=8: with 3 concurrent jobs → 3×8×4 GB = 96 GB peak for MINIMAC4,
    // leaving 80 GB headroom for EAGLE + CALCULATE_CHUNKS + OS across all jobs.
    withName: 'MINIMAC4' {
        cpus      = 2
        memory    = { 4.GB * task.attempt }
        maxForks  = 8
        errorStrategy = { task.exitStatus == 1 ? 'retry' : (task.exitStatus == null || task.exitStatus in ((130..145) + 104 + 151) ? 'retry' : 'terminate') }
        afterScript = '''
            # Delete the phased VCF staged from EAGLE's work dir only on success.
            # Presence of *.dose.vcf.gz confirms the task completed successfully.
            if ls *.phased.dose.vcf.gz 2>/dev/null | grep -q .; then
                for f in *.phased.vcf.gz; do
                    [ -L "$f" ] && rm -f "$(readlink -f "$f")" 2>/dev/null; true
                done
            fi
        '''
    }

    // CALCULATE_CHUNKS: actual peak RSS ~700 MB; Java heap = task.memory * 0.8.
    // Right-size memory from 4 GB → 2 GB (heap = 1638 MB, plenty).
    // Give 2 CPUs so it can overlap with the 16 MINIMAC4 tasks on the remaining cores.
    // Disk safety: afterScript deletes the large MINIMAC4 dose/empirical VCFs only on
    // success (confirmed by presence of *.scores.txt output), keeping them available
    // if this task needs to be retried.
    withName: 'CALCULATE_CHUNKS' {
        cpus   = 2
        memory = { 2.GB * task.attempt }
        afterScript = '''
            if ls *.scores.txt 2>/dev/null | grep -q .; then
                for f in *.phased.dose.vcf.gz *.phased.empiricalDose.vcf.gz *.phased.info.gz; do
                    [ -L "$f" ] && rm -f "$(readlink -f "$f")" 2>/dev/null; true
                done
            fi
        '''
    }

}
