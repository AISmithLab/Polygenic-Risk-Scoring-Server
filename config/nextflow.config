params.send_mail=true
params.max_samples = 40000
params.min_samples = 1

// ability to restart jobs
resume = true

// Cloudgene runs up to 3 jobs concurrently (threadsQueue: 3 in settings.yaml).
// Divide machine resources across 3 jobs: 64 CPUs / 3 ≈ 20 per job, 240 GB / 3 = 80 GB per job.
// Each Nextflow instance is unaware of sibling jobs, so we cap it here.
executor {
    name   = 'local'
    cpus   = 20
    memory = '80 GB'
}